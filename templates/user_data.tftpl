#cloud-config
hostname: ${name}
preserve_hostname: false

bootcmd:
  - apt-get update
  - apt-get install -y nfs-common

%{ if os == "ubuntu24" ~}
apt:
  primary:
    - arches: [default]
      uri: ${mirror_url}/ubuntu
  security:
    - arches: [default]    
      uri: ${mirror_url}/ubuntu
  preserve_sources_list: ${!use_mirror}
%{ endif ~}
%{ if os == "debian12" ~}
apt:
  primary:
    - arches: [default]
      uri: ${mirror_url}/debian
  security:
    - arches: [default]    
      uri: ${mirror_url}/debian-security
  preserve_sources_list: ${!use_mirror}
  sources_list: |
    deb ${mirror_url}/debian bookworm main contrib non-free non-free-firmware
    deb ${mirror_url}/debian bookworm-updates main contrib non-free non-free-firmware
    deb ${mirror_url}/debian-security bookworm-security main contrib non-free non-free-firmware
%{ endif ~}
%{ if os == "debian13" ~}
apt:
  primary:
    - arches: [default]
      uri: ${mirror_url}/debian
  security:
    - arches: [default]    
      uri: ${mirror_url}/debian-security
  preserve_sources_list: ${!use_mirror}
  sources_list: |
    deb ${mirror_url}/debian trixie main contrib non-free non-free-firmware
    deb ${mirror_url}/debian trixie-updates main contrib non-free non-free-firmware
    deb ${mirror_url}/debian-security trixie-security main contrib non-free non-free-firmware
%{ endif ~}

users:
  - name: ${username}
    passwd: ${password}
    lock_passwd: false
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
%{ for key in ssh_keys ~}
      - ${trimspace(key)}
%{ endfor ~}
%{ for user in users ~}
%{   if lookup(user, "ssh_key", "") != "" ~}
      - ${trimspace(user.ssh_key)}
%{   endif ~}
%{ endfor ~}

%{ for user in users ~}
  - name: ${user.name}
%{   if lookup(user, "groups", "") != "" ~}
    groups: ${user.groups}
%{   endif ~}
    shell: ${lookup(user, "shell", "/bin/bash")}
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: true
%{   if lookup(user, "ssh_key", "") != "" ~}
    ssh_authorized_keys:
      - ${trimspace(user.ssh_key)}
%{   endif ~}
%{ endfor ~}

package_update: true
package_upgrade: true

# Global packages
packages:
  - qemu-guest-agent
  - cloud-initramfs-growroot
  - curl
  - htop
  - vim
  - nfs-common
%{ for pkg in extra_packages ~}
  - ${pkg}
%{ endfor ~}

growpart:
  mode: auto
  devices: ['/']
  ignore_growpart: false

resize_rootfs: true

%{ if length(mounts) > 0 ~}
mounts:
%{ for m in mounts ~}
  - - "${m[0]}"
    - "${m[1]}"
    - "${m[2]}"
    - "${m[3]}"
    - "${m[4]}"
    - "${m[5]}"
%{ endfor ~}
%{ endif ~}

write_files:
  #Force apt ipv4
  - path: /etc/apt/apt.conf.d/99force-ipv4
    permissions: '0644'
    content: |
      Acquire::ForceIPv4 "true";

  # Environmental variables for every VM
  - path: /etc/environment
    content: |
      NETBOX_ID=${vmid}
      VM_NAME=${name}
      environment=${env}
    append: true


%{ for file in extra_files ~}
  - path: ${file.path}
    content: |
      ${indent(6, replace(file.content, "$${env}", env))}
%{ endfor ~}

runcmd:
  - systemctl restart qemu-guest-agent || true
%{ for cmd in extra_commands ~}
  - ${cmd}
%{ endfor ~}
  - sed -i '/\/media\/cdrom/s/^/#/' /etc/fstab || true
  - systemctl daemon-reload
